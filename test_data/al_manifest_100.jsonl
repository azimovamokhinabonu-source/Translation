{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000000.wav", "duration": 4.788, "text": "Bugun ertalab Gyotenikiga taklifnoma oldim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000001.wav", "duration": 5.076, "text": "Uning badiiy tasvir imkoniyatlarini rivojlantiradi"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000002.wav", "duration": 4.14, "text": "Udan koʻra balandroq joy bor."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000003.wav", "duration": 7.56, "text": "Bu jumlada figʻoni falakka chiqib birikmasi ibora boʻlgani uchun vergul talab qilmaydi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000004.wav", "duration": 5.436, "text": "Bundan tashqari puxta jamlangan kutubxona bor."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000005.wav", "duration": 3.528, "text": "Ularni hal qilishni paysalga soladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000006.wav", "duration": 4.428, "text": "Xullas, qiziq maqola, oʻqishni tavsiya qilaman."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000007.wav", "duration": 5.076, "text": "Diningizni kimdan olayotganingizga qarang."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000008.wav", "duration": 3.78, "text": "Ota-onasi kitob oʻqigan bolalardir."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000009.wav", "duration": 4.428, "text": "Shu tariqa qandaydir ezgu ishni amalga oshirasiz"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000010.wav", "duration": 4.536, "text": "Ular ruhiy kechinmalaringizning kundaligi boʻladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000011.wav", "duration": 4.5, "text": "Oʻzbegimni oʻqib, ovunganlarini, boʻzlardi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000012.wav", "duration": 3.996, "text": "Bu borada dadil qalam tebratgan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000013.wav", "duration": 7.056, "text": "Bu tanlov doirasida turli meʼmorchilik loyihalari baholanadi va taqdirlanadi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000014.wav", "duration": 3.996, "text": "Ovoz berib, yigʻlay, dedi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000015.wav", "duration": 6.12, "text": "Erk – manzilmas, erk – yoʻldir"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000016.wav", "duration": 4.5, "text": "Boʻlmagan bir tarzda hayot kechira boshlaydilar."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000017.wav", "duration": 8.856, "text": "Sen oʻz uyingni bermayotganing va shuning uchun ular ham uyni ololmasliklarini aytadi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000018.wav", "duration": 3.78, "text": "Uni boricha chizib bera olar ekan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000019.wav", "duration": 3.456, "text": "Shu muddat ichida koʻrishib oldi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000020.wav", "duration": 5.076, "text": "Ular ustida unchalik ilhom bilan ishlamaganimni aytdim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000021.wav", "duration": 4.428, "text": "Kechikmaslik uchun yarim soatcha oldin bordim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000022.wav", "duration": 4.248, "text": "Qirgʻizistonlik olimlar shu nomli tadqiqot oʻtkazibdi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000023.wav", "duration": 3.816, "text": "Bu shaxs goʻyo hech bir hayajonlanmaydi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000024.wav", "duration": 3.276, "text": "Hali benzin olish kerak, ishga borish kerak."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000025.wav", "duration": 6.696, "text": "Bilishim boʻyicha, oʻsha voqealar haqida koʻp maʼlumotlar haliyam sir saqlanadi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000026.wav", "duration": 4.068, "text": "Haqiqiy muhabbat yashirin boʻladi, oshkor emas."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000027.wav", "duration": 4.068, "text": "Har qanday milliy urf-u odat bor."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000028.wav", "duration": 4.068, "text": "Koʻngil arshigacha yuksalish kerak."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000029.wav", "duration": 6.876, "text": "Agar qachondir iqtisodiy islohotlar qilishni boshlasak, bunday ishonch darajasi foydamizga ishlashi aniq."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000030.wav", "duration": 3.24, "text": "Shoir shundan doim noliydi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000031.wav", "duration": 4.248, "text": "— Non dema! — dedi. — Nonni otini atama!"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000032.wav", "duration": 6.84, "text": "Startaplar haqida va ularni yurgizish haqida eng yaxshi kitoblardan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000033.wav", "duration": 3.996, "text": "Oʻsha ishni asosiy kasbiga aylantira olishi kerak."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000034.wav", "duration": 3.096, "text": "Ayni shu ijodkor qatʼiyati."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000035.wav", "duration": 3.276, "text": "Maskada yurish kerak emas dedi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000036.wav", "duration": 3.708, "text": "Bir kunda va birdaniga paydo boʻlmas."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000037.wav", "duration": 7.38, "text": "Empirik tadqiqotlarda, doim qandaydir identifikatsiyaga bogʻliq farazlar boʻladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000038.wav", "duration": 4.716, "text": "Barcha holatlarni yaxlit bir holga keltirmadi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000039.wav", "duration": 6.66, "text": "Oyogʻi ostida yirtilib, qamishlari qovurgʻadek turtib chiqqan varrak loyga qoʻrishib yotibdi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000040.wav", "duration": 4.536, "text": "Bu saylovlarda Vitse-prezident kreslosi juda muhim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000041.wav", "duration": 2.988, "text": "Inson yuragi esa misoli bir dengiz."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000042.wav", "duration": 3.348, "text": "Qatʼiyat bilan egizak tugʻilgan edi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000043.wav", "duration": 5.796, "text": "Lekin masalan Fevralda, barcha Osiyo mamlakatlarida maska kiyish boshlangan edi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000044.wav", "duration": 7.02, "text": "Holbuki, hozir bu tushunchalar bilan oʻquvchilar birinchi sinfdayoq tanishyapti."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000045.wav", "duration": 4.68, "text": "Bugun Sharifjon negadir oʻzini ancha dadilroq tutdi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000046.wav", "duration": 3.276, "text": "Bir marta Turkiyada birga safarda boʻlganmiz."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000047.wav", "duration": 2.916, "text": "Qoʻzgʻolonlarning boshlanishi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000048.wav", "duration": 3.096, "text": "Xullas, Erkin aka bahona edi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000049.wav", "duration": 3.528, "text": "Unda shunchalar oliyjanoblik va qatʼiyat bor."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000050.wav", "duration": 7.56, "text": "Tasavvur qiling, daryoda choʻkayotgan yoki yongʻinda qolgan odamlarni qutqarishda son muhim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000051.wav", "duration": 4.356, "text": "Bolaligimdan xorijiy universitetda tahsil olish niyatim boʻlgan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000052.wav", "duration": 4.5, "text": "Hech boʻlmaganda avlodlarimiz rivojlangan jamiyatda yashasin."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000053.wav", "duration": 3.168, "text": "Oʻsha-oʻsha doʻzax langʻillab yonarmish."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000054.wav", "duration": 2.88, "text": "Ovqat hammaga yetib ortibdi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000055.wav", "duration": 3.888, "text": "Nazarimda, oʻqilayotgan kitobda gap koʻp."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000056.wav", "duration": 3.708, "text": "Qayoqdan kompozitorning qoʻliga tushdi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000057.wav", "duration": 6.66, "text": "Mamlakatning investitsion muhiti ham, masalaning tagiga qarasak, shunga bogʻliq."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000058.wav", "duration": 5.796, "text": "Jamoamiz siz azizlarni saharlik va iftorlik dasturxoniga taklif qiladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000059.wav", "duration": 3.24, "text": "Nima ovqat yeganingizni soʻrasa, hayron boʻlmang."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000060.wav", "duration": 3.78, "text": "Eng katta rahbarlarning kelishiga bagʻishlangan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000061.wav", "duration": 3.888, "text": "Rassom tavalludiga bagʻishlangan koʻrgazma ochiladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000062.wav", "duration": 2.448, "text": "Uyda oʻtirgan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000063.wav", "duration": 4.356, "text": "Rahbari internetda mavjud ayrim xatarlar haqida gapirgan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000064.wav", "duration": 3.096, "text": "Eng kamida, muhokama qilinishi mumkin."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000065.wav", "duration": 5.256, "text": "Rejadagi bandlarni toʻrt, besh yoki oltitagacha ham tuzish mumkin."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000066.wav", "duration": 3.06, "text": "Nimani buncha baqirib oʻqiysan dedi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000067.wav", "duration": 5.04, "text": "Ilk oʻrta asrlar madaniyatining shakllanishida mustahkam poydevorga aylangan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000068.wav", "duration": 2.628, "text": "Umaviylarning agʻdarilishi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000069.wav", "duration": 3.348, "text": "Erkin aka bir pas koʻzdan gʻoyib boʻldi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000070.wav", "duration": 6.48, "text": "Uni ushbu vaziyatda ayblash nojoiz, futbolchi tanasini toʻp yoʻlidan olib qocha olmadi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000071.wav", "duration": 2.736, "text": "Muhtaram soʻzi qanday holatda?"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000072.wav", "duration": 3.276, "text": "Bu uchrashuvda qatnashayotgan oʻrtoqlar."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000073.wav", "duration": 3.708, "text": "Faqat sip-sinalgan tep-tekis yoʻllar u."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000074.wav", "duration": 8.676, "text": "Boshingda quyosh charaqlab turganida izingdan qolmaydigan, boshingga bulut kelganida xiyonat qiladigan doʻst dushman."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000075.wav", "duration": 4.68, "text": "Oʻrta Osiyoda ularning davlati faoliyat koʻrsatgan."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000076.wav", "duration": 4.788, "text": "Sharqiy turk xoqonligi va gʻarbiy turk xoqonligiga boʻlinib ketadi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000077.wav", "duration": 5.76, "text": "Toʻrtinchidan, emlash albatta ixtiyoriy boʻlishi toʻgʻri boʻlar edi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000078.wav", "duration": 6.588, "text": "Ana shunda hech kim seni yigʻloqi yoki janjalkash deb atashiga bahona boʻlmaydi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000079.wav", "duration": 5.94, "text": "— Otangni koʻrdim, ahmadi forigʻ, enangni koʻrdim, tovoni yoriq, deydilar."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000080.wav", "duration": 5.22, "text": "Bir dehqon qoʻshchini izidan yetdi. Qoʻshchini bilagidan tutamladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000081.wav", "duration": 4.788, "text": "— Non dema-ya, qirilib ketgur! — deya, bolasi"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000082.wav", "duration": 2.628, "text": "Unda \"nimanidir\" ilgʻab oldim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000083.wav", "duration": 4.32, "text": "Har bir sheʼringizning ostiga yozgan sanangizni qoʻying."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000084.wav", "duration": 5.76, "text": "Buni koʻrgan bogʻbonning xotini qoʻliga miltiq olib, eshakni otib tashladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000085.wav", "duration": 3.636, "text": "Unga maʼqul boʻlganimni his etardim."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000086.wav", "duration": 6.696, "text": "Koʻpchilikning nazaridan chetda qolgan, lekin aslida qiziq va foydali boʻlgan mavzularni yoritish."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000087.wav", "duration": 7.56, "text": "Binomiz bezatilyapti, bayram uchun emas, inspektor keladi"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000088.wav", "duration": 4.32, "text": "Axir uni deb yashayapmiz, chopayapmiz."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000089.wav", "duration": 3.816, "text": "Voy, nega qargʻamas ekanman?"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000090.wav", "duration": 2.88, "text": "Boʻlmasin der sobitlar."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000091.wav", "duration": 5.508, "text": "Yangi Oʻzbekistonni bogʻu boʻstonga aylantiraylik!ng"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000092.wav", "duration": 4.068, "text": "Va kaliso tinchin buzib endi bir zamon"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000093.wav", "duration": 2.628, "text": "kimdir sayroq bilan"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000094.wav", "duration": 2.916, "text": "Keyin barqarorlikka erishiladi"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000095.wav", "duration": 7.488, "text": "Hududlarda servis sohalari koʻlamini kengaytirish orqali yangi ish oʻrni yaratiladi."}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000096.wav", "duration": 5.76, "text": "Yoʻq,-dedim, — qarshiman, bola qalbida"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000097.wav", "duration": 8.1, "text": "Shu oʻrinda savol tugʻiladi koʻzlaringiz irodangizning tarbiyalovchisi ekanidan xabaringiz bormi"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000098.wav", "duration": 4.32, "text": "Akam bu uydan bola-chaqasini olib chiqib ketsin"}
{"audio_filepath": "/workspace/clean/uz/common_voice_uz/audio/common_voice_uz_00000099.wav", "duration": 3.996, "text": "bola pulining bir oyligini urib qoluvchi"}
